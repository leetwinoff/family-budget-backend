SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set by Railway automatically — leave empty locally if using SQLite for dev
DATABASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
