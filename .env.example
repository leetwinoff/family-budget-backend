# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.web.app

# ExchangeRate-API — get free key at https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here
